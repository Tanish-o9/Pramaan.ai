# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Server & Auth
PORT=8000
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
COOKIE_SECURE=false # Set to true when running behind HTTPS in production
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Biometric Model Tuning
FACE_MATCH_THRESHOLD=0.60    # Euclidean distance threshold (lower = stricter match)
LIVENESS_EAR_THRESHOLD=0.16  # Eye Aspect Ratio threshold (higher = stricter eye check)

